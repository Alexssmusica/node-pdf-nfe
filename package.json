{
  "name": "@alexssmusica/node-pdf-nfe",
  "version": "1.5.0",
  "description": "Modulo que auxilia na geração da DANFE da NF-e e NFC-e e da DANFSe da NFS-e.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "author": {
    "name": "Alex Santos de Souza",
    "url": "https://github.com/Alexssmusica/node-pdf-nfe/#readme",
    "email": "alexssmusica@gmail.com"
  },
  "files": [
    "/lib",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "NFe",
    "NFCe",
    "NFSe",
    "Danfe",
    "DANFSe"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexssmusica/node-pdf-nfe.git"
  },
  "homepage": "https://danfenfeonline.com.br/gerar-danfe",
  "scripts": {
    "build-release": "npm run format && npm run build && node release.js && npm run publish:npm",
    "clean-lib": "npx rimraf lib && npx rimraf tsconfig.tsbuildinfo",
    "build": "npm run clean-lib && tsc -p tsconfig.json && npm run copy-assets",
    "format": "prettier src/**/*.{js,ts} --write",
    "publish:npm": "node publish.js",
    "type": "tsc --project tsconfig.json",
    "copy-assets": "copyfiles \"src/assets/**/*\" lib/ -u 1",
    "test-pdf": "nodemon --watch src ./tests/pdf.test.ts",
    "test": "ts-node ./tests/pdf.test.ts"
  },
  "dependencies": {
    "@bwip-js/node": "4.11.4",
    "date-fns": "4.4.0",
    "fast-xml-parser": "5.12.1",
    "pdfkit": "0.21.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "native-copyfiles": "^2.1.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "semantic-release": "^25.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
